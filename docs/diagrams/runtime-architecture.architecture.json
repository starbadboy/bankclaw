  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path — import a statement",
      "items": [
        "POST /api/import with Bearer token; uploads read on the event loop",
        "≤2 PDFs parsed concurrently via asyncio.to_thread (monopoly-core)",
        "BankDetector → 18+ banks, else GenericBank + warning; OCR if no text layer",
        "Optional DeepSeek categorization; upsert keyed user+date+description+amount+bank"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "All /api/* routes need the HMAC token except login, google, public-config, health",
        "AUTH_TOKEN_SECRET falls back to a dev value when unset",
        "Login is demo mode (any credentials) when no user store is reachable",
        "SPA fallback stays inside dashboard/; index is no-cache with mtime asset version"
      ]
    },
    {
      "dot": "amber",
      "title": "Dependencies & deployment",
      "items": [
        "MONGODB_URL optional — persistence degrades gracefully; compose adds mongo:7.0",
        "DEEPSEEK_API_KEY / DEEPSEEK_MODEL (OpenAI SDK); GOOGLE_CLIENT_ID; yfinance keyless",
        "Browser loads React 18 + Babel from unpkg (SRI) and Google Fonts",
        "python:3.12-slim image + poppler/ocrmypdf/tesseract; Railway checks /api/health",
        "Legacy Streamlit UI + Tauri desktop wrapper are in the repo, outside this runtime"
      ]
    }
  ]
